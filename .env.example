# Copy to .env.local for `vercel dev`, or set these in the Vercel dashboard.
# Every one of them is optional. With none set, /api/model answers
# "unavailable" and the app renders exactly as it did before — procedural
# pieces, instantly, for free.

# Image-to-3D provider. Without this key nothing is ever generated.
# https://www.meshy.ai — the account page issues the key.
MESHY_API_KEY=

# Triangles per generated piece described only by name. Those come back as
# untextured silhouettes, and at room distance a 3,000-triangle sofa and a
# 30,000-triangle one look identical while the payload differs tenfold.
MODEL_TRIANGLE_BUDGET=3000

# Triangles for a piece generated from a real product photo. Those keep their
# texture, and a photograph needs a surface good enough to sit on before the
# detail pays for itself.
MODEL_PHOTO_TRIANGLE_BUDGET=12000

# Per-instance ceiling on new generations per hour. A brake on one runaway
# client, not a billing control — see the note in api/model.js.
MODEL_MAX_JOBS_PER_HOUR=40

# Durable cache. Set automatically when a Vercel Blob store is linked to the
# project. Without it the CDN and each warm instance still cache, but a deploy
# throws the meshes away and they get paid for again.
BLOB_READ_WRITE_TOKEN=
